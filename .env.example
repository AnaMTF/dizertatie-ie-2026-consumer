RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASS=app
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=60
RABBITMQ_BLOCKED_TIMEOUT=120

RABBITMQ_JOB_QUEUE=scan.jobs.v1
RABBITMQ_RESULT_QUEUE=scan.results.v1
RABBITMQ_DLX=scan.dlx
RABBITMQ_JOB_DLQ=scan.jobs.v1.dlq
RABBITMQ_RESULT_DLQ=scan.results.v1.dlq
WORKER_PREFETCH=1

DEFAULT_MODEL_PATH=./models/default.keras
